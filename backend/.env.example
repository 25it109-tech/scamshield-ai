# OpenRouter key used by ai/llm_analyzer.py
OPENROUTER_API_KEY=your_openrouter_api_key

# VirusTotal key used by security/security_check.py
VT_API_KEY=your_virustotal_api_key

# SQLite database path. This is resolved relative to the backend directory
# when the server is started from backend/.
DATABASE_URL=sqlite:///./scamshield.db
